# ATLAS backend configuration. Copy to backend/.env and adjust as needed.

# Network
ATLAS_BACKEND_HOST=0.0.0.0
ATLAS_BACKEND_PORT=8000

# Agent execution mode:
#   auto = use the real agent if its deps import and Ollama is reachable, else mock
#   real = force the real agent (requires Ollama + a desktop session + ml deps)
#   mock = never load the agent; simulate progress (great for demos and CI)
#   plan = never execute; stream the plan only (safe dry run / preview)
ATLAS_AGENT_MODE=auto

# Ollama server used by the real agent
OLLAMA_BASE_URL=http://localhost:11434

# Delay between simulated steps in mock mode, in seconds
ATLAS_MOCK_STEP_DELAY=0.4

# CORS: "*" allows any origin, or a comma-separated allowlist
ATLAS_CORS_ORIGINS=*
