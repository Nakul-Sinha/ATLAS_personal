# ATLAS - root environment template
#
# This is a convenience aggregate. Each component also ships its own .env.example
# (backend/.env.example, ml/mcp/.env.example). Copy the relevant file to .env and
# fill in values. Never commit real secrets.

# ---- Backend (FastAPI relay) ----
ATLAS_BACKEND_HOST=0.0.0.0
ATLAS_BACKEND_PORT=8000
# Run the agent for real (requires Ollama + a desktop session) or force mock mode.
# auto = use the real agent if it imports and Ollama is reachable, else mock.
ATLAS_AGENT_MODE=auto

# ---- ML agent (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
ATLAS_LLM_MODEL=llama3.2
ATLAS_VLM_MODEL=llava

# ---- MCP browser agent ----
# See ml/mcp/.env.example for the full list.
LLM_BACKEND=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
